# Copy to .env (or inject the same keys from Dockhand). Never commit real values.
RELAY_PORT=8097

# Existing internal docker network (shared with the reverse proxy).
# The relay joins it as hostname "relay", so the proxy targets http://relay:8097.
# Leave unset for the default bridge.
#INTERNAL_NETWORK=homelab-net

# Host directory holding /data (queue, answers, app registry, fact log).
# Must exist (created automatically) and be writable by uid 65534.
HOST_DATA_DIR=/opt/docker/zepp-relay

# Operator token (admin + phone side hold this; senders get per-app tokens
# from the dashboard). Generate: openssl rand -base64 32
RELAY_TOKEN=change-me-before-first-start
